{
  "version": 1,
  "vectors": [
    {
      "name": "public-prefix-then-tenant",
      "fragments": [
        {
          "id": "tools",
          "constraints": {
            "retention": {"mode": "allow", "max_age": 86400},
            "reuse": "exact",
            "share_max": "public",
            "namespace": "tools:v7"
          }
        },
        {
          "id": "system",
          "constraints": {
            "retention": {"mode": "allow", "max_age": 3600},
            "reuse": "exact",
            "share_max": "tenant",
            "namespace": "agent:v4"
          }
        }
      ],
      "expected": {
        "after_fragment_0": {"share_max": "public", "max_age": 86400, "reuse": "exact"},
        "after_fragment_1": {"share_max": "tenant", "max_age": 3600, "reuse": "exact"}
      }
    },
    {
      "name": "tenant-prefix-then-public-does-not-widen",
      "fragments": [
        {
          "id": "system",
          "constraints": {
            "retention": {"mode": "allow"},
            "reuse": "exact",
            "share_max": "tenant"
          }
        },
        {
          "id": "tools",
          "constraints": {
            "retention": {"mode": "allow"},
            "reuse": "exact",
            "share_max": "public"
          }
        }
      ],
      "expected": {"after_fragment_1": {"share_max": "tenant", "reuse": "exact"}}
    },
    {
      "name": "no-retention-propagates",
      "fragments": [
        {
          "id": "medical-intake",
          "constraints": {
            "retention": {"mode": "forbid"},
            "reuse": "none",
            "share_max": "request"
          }
        },
        {
          "id": "later-instruction",
          "constraints": {
            "retention": {"mode": "allow"},
            "reuse": "exact",
            "share_max": "tenant"
          }
        }
      ],
      "expected": {
        "after_fragment_1": {
          "retention": {"mode": "forbid"},
          "reuse": "none",
          "share_max": "request"
        }
      }
    },
    {
      "name": "exact-dominates-approximate",
      "fragments": [
        {
          "id": "a",
          "constraints": {
            "retention": {"mode": "allow"},
            "reuse": "approximate",
